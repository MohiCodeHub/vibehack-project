# ---- Where To? environment ----

# Run the entire game with NO external API calls (recommended for demos).
# When true (or when keys are missing), AI + places use built-in mocks.
# NOTE: USE_MOCKS=true forces mocks even if a key is set — flip to false to use a real LLM.
USE_MOCKS=true

# LLM — used for swipe cards + comedic restaurant questions.
# Provider: openai (default) or anthropic. Leave LLM_API_KEY blank to force mocks for AI.
LLM_PROVIDER=openai
LLM_API_KEY=
# Model default depends on provider: openai → gpt-4o-mini, anthropic → claude-haiku-4-5-20251001
LLM_MODEL=gpt-4o-mini

# Places (Google Places API v1) — used to resolve real nearby restaurants.
# Leave blank to force mocks for places.
PLACES_API_KEY=

# Fallback city when a player denies geolocation.
DEFAULT_CITY=San Francisco

# Split deploy only (Vercel client → Render backend): comma-separated allowed
# browser origins, no trailing slash. e.g. https://where-to.vercel.app
# Any *.vercel.app preview deploy is allowed automatically. Leave blank for local.
CLIENT_ORIGIN=

# Server port (Render/Railway/Fly set this automatically).
PORT=3001
